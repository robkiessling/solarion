{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "types": ["vite/client"],

    // Type-check the existing JavaScript in place (no renames). Files opt in with a `// @ts-check` line;
    // files without it still contribute their JSDoc-declared types to importers but are not checked themselves.
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    // Deliberately loose to start: untyped parameters are `any`, null/undefined are not tracked.
    // Tighten (strictNullChecks, noImplicitAny) once the record types have settled.
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
