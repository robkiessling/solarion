{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "types": ["vite/client"],

    // The React components are still JavaScript (.jsx); allowJs lets them import the typed modules without being
    // checked themselves. A .js/.jsx file can opt into checking with a `// @ts-check` line. Everything else is .ts
    // and checked under strict.
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
